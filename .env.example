# Copy to .env and fill in real values. .env is gitignored - never commit it.

# --- Database (compose sets this for the api container automatically) ---------------
DATABASE_URL=postgresql+psycopg2://evidence:change_me@db:5432/evidence

# --- Postgres container credentials (docker-compose.yml) ---------------------------
POSTGRES_USER=evidence
POSTGRES_PASSWORD=change_me
POSTGRES_DB=evidence

# --- Agent -------------------------------------------------------------------------
# provider: deepseek (OpenAI-compatible) | anthropic
AGENT_PROVIDER=deepseek
# live = call the model; mock = return the bundled canned draft (offline demo, no key needed)
AGENT_MODE=live

# DeepSeek (default provider)
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat

# Anthropic (alternate provider; set AGENT_PROVIDER=anthropic and AGENT_MODEL=claude-sonnet-5)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
